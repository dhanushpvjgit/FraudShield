{
  "uid": "fraudshield-overview",
  "title": "FraudShield - Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "fraudshield"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Transactions ingested / s",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fraudshield_transactions_ingested_total[1m])",
          "legendFormat": "ingested",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Duplicate submissions ignored / s",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fraudshield_transactions_duplicates_total[1m])",
          "legendFormat": "duplicates",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingest latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(fraudshield_ingest_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka publish failures / s",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fraudshield_kafka_publish_failures_total[1m])",
          "legendFormat": "failures",
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          }
        }
      ]
    }
  ]
}